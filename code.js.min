javascript:(function(){try{const url=window.location.href,hostname=window.location.hostname,pathname=window.location.pathname;let title='';const jiraSummary=document.querySelector('#summary-val');if(jiraSummary){const key=pathname.split('/').pop();title=`${key} - ${jiraSummary.innerText.trim()}`;}else if((hostname.includes('github.com')||hostname.includes('git.corp.adobe.com'))&&/\/[^/]+\/[^/]+\/pull\/\d+/.test(pathname)){const match=pathname.match(/^\/([^/]+)\/([^/]+)\/pull\/(\d+)/);if(match){const[ ,owner,repo,prNumber]=match;const prTitleEl=document.querySelector('.js-issue-title');const prTitle=prTitleEl?prTitleEl.innerText.trim():document.title.trim();title=`${prTitle} - ${owner}/${repo}#${prNumber}`;}}else{title=document.title.trim();}if(!title)throw new Error('Title not found');const formatted=`[${title}](${url})`;if(navigator.clipboard){navigator.clipboard.writeText(formatted).then(()=>showToast('✅ Copied!','#0052cc')).catch(()=>fallbackCopy(formatted));}else{fallbackCopy(formatted);}function fallbackCopy(text){const textarea=document.createElement('textarea');textarea.value=text;textarea.setAttribute('readonly','');textarea.style.position='absolute';textarea.style.left='-9999px';document.body.appendChild(textarea);textarea.select();const success=document.execCommand('copy');document.body.removeChild(textarea);showToast(success?'✅ Copied!':'❌ Copy failed','#0052cc');}}catch(e){showToast('❌ Error: '+e.message,'#cc0000');}function showToast(message,bgColor){const toast=document.createElement('div');toast.textContent=message;Object.assign(toast.style,{position:'fixed',top:'20px',right:'20px',padding:'10px 16px',background:bgColor,color:'white',fontWeight:'bold',borderRadius:'8px',boxShadow:'0 4px 8px rgba(0,0,0,0.2)',zIndex:9999,fontSize:'14px',opacity:'0.95'});document.body.appendChild(toast);setTimeout(()=>toast.remove(),2500);}})();
